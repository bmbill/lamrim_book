{
  "name": "lamrim-book-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/build-icons.mjs",
    "build": "npx tsc && vite build",
    "preview": "vite preview",
    "build:transcripts": "node --max-old-space-size=4096 scripts/build-lamrim-transcripts.mjs",
    "build:fengshan": "node scripts/build-fengshan-transcripts.mjs",
    "build:kepan": "node scripts/build-lamrim-kepan.mjs",
    "build:transcripts:all": "npm run build:transcripts && npm run build:fengshan && npm run build:kepan"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "jszip": "^3.10.1",
    "sharp": "^0.33.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
